{"nodes": [{"id": "converted_buildai_user_stories_bf50325a_user_story_index", "label": "BuildAI User Story Index (BuildAI-User-Stories.xlsx)", "file_type": "document", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "Sheet: User stories", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version 2 du 25/11/2026: index of 44 user stories (US-001..US-044), 180 points total, 72 points remaining; 25 stories exist, 4 partially exist, 15 to implement. Story details (criteria, scenarios) are kept in BuildAI-Suivi-User-Stories.docx; 'Assign\u00e9 \u00e0' column still to fill."}, {"id": "converted_buildai_user_stories_bf50325a_suivi_user_stories_docx", "label": "BuildAI-Suivi-User-Stories.docx", "file_type": "document", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "Sheet: User stories, row 2", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "converted_buildai_user_stories_bf50325a_epic_rag_hybride", "label": "Epic: Recherche documentaire et RAG hybride", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-001..US-005, US-029, US-032, US-033", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-001, US-002, US-003, US-004, US-005, US-029, US-032, US-033", "points": 32, "remaining_points": 6, "earlier_sprints": "Sprint 2, Sprint 3", "rationale": "Learners ask technical BTP questions in natural French; BM25 (Elasticsearch) is combined with vector search (Qdrant) to catch both exact technical terms and rephrased questions; trainer persona makes answers pedagogical; model chosen via config to adapt to hardware without rebuild."}, {"id": "converted_buildai_user_stories_bf50325a_epic_tracabilite_pdf", "label": "Epic: Tra\u00e7abilit\u00e9 documentaire et PDF", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-006, US-007, US-008, US-030", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-006, US-007, US-008, US-030", "points": 20, "remaining_points": 0, "earlier_sprints": "Sprint 3", "rationale": "Numbered clickable citations let engineers verify the source of a calculation or rule; cited PDFs are stored and served locally so links never die (no 404 / vanished site)."}, {"id": "converted_buildai_user_stories_bf50325a_epic_generation_cours", "label": "Epic: G\u00e9n\u00e9ration de cours multi-agents", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-009..US-012", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-009, US-010, US-011, US-012", "points": 19, "remaining_points": 3, "earlier_sprints": "Sprint 4", "rationale": "Trainers request a course on a theme, get a structured outline, agents write each chapter from the document base, export to .docx/Markdown; stopping a long generation (US-012) frees the GPU for chat without restarting the server."}, {"id": "converted_buildai_user_stories_bf50325a_epic_qcm_evaluations", "label": "Epic: QCM et \u00e9valuations", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-013, US-014, US-015", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-013, US-014, US-015", "points": 11, "remaining_points": 11, "rationale": "Generate 5-10 question MCQs on a BTP theme, with an explanation per question so learners understand mistakes, exported as separate student and answer-key versions. Entirely to implement."}, {"id": "converted_buildai_user_stories_bf50325a_epic_ingestion_donnees", "label": "Epic: Ingestion et pr\u00e9paration des donn\u00e9es", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-016..US-019, US-031, US-037", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-016, US-017, US-018, US-019, US-031, US-037", "points": 27, "remaining_points": 11, "earlier_sprints": "Sprint 1", "rationale": "Scrape btp-cours.com and geniecivilpdf.com automatically; reject social-share pages and external scripts to avoid fake login forms/malicious content; chunk into 500-900 char overlapping passages so formulas/sentences are not cut; one script indexes into both Elasticsearch and Qdrant to keep indexes consistent; incremental reindexing avoids recomputing everything."}, {"id": "converted_buildai_user_stories_bf50325a_epic_interface_utilisateur", "label": "Epic: Interface utilisateur", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-020..US-023, US-028", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-020, US-021, US-022, US-023, US-028", "points": 15, "remaining_points": 0, "earlier_sprints": "Sprint 2, Sprint 4", "rationale": "Chat UI usable on desktop and tablet, conversation history side panel, keyword search across conversations, proper rendering of formulas and tables, switch between Q&A assistant and course generator."}, {"id": "converted_buildai_user_stories_bf50325a_epic_navigation_partage", "label": "Epic: Navigation et partage des conversations", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-039..US-044", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-039, US-040, US-041, US-042, US-043, US-044", "points": 23, "remaining_points": 21, "rationale": "Fork a conversation from a message, edit prompts keeping old versions, view the conversation as a branch tree, restart from any node, share by link so a student continues, ask a question about a selected excerpt. Mostly LibreChat evolutions."}, {"id": "converted_buildai_user_stories_bf50325a_epic_infrastructure_deploiement", "label": "Epic: Infrastructure et d\u00e9ploiement", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "US-024..US-027, US-034..US-036, US-038", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-024, US-025, US-026, US-027, US-034, US-035, US-036, US-038", "points": 33, "remaining_points": 20, "earlier_sprints": "Sprint 3", "rationale": "One-command reproducible install (docker compose up -d); Ollama on NVIDIA GPU for speed; Bearer token protects documents and GPU; stay under 4 GB VRAM to avoid OOM crashes on mid-range GPUs; health endpoint for Docker checks; secrets out of versioned files; CI tests on every push; GPU/latency monitoring."}, {"id": "converted_buildai_user_stories_bf50325a_sprint_5", "label": "Sprint 5 (2026-11-30 to 2026-12-11)", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "Sheet: Planning, Sprint 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-024, US-026, US-034, US-035, US-036, US-039, US-041", "planned_points": 19, "capacity_gap": 1, "rationale": "Objectif: s\u00e9curiser et fiabiliser le d\u00e9ploiement, poser les tests automatiques."}, {"id": "converted_buildai_user_stories_bf50325a_sprint_6", "label": "Sprint 6 (2027-01-04 to 2027-01-15)", "file_type": "concept", "source_file": "graphify-out/converted/BuildAI-User-Stories_bf50325a.md", "source_location": "Sheet: Planning, Sprint 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "stories": "US-012, US-017, US-018, US-032, US-037", "planned_points": 17, "capacity_gap": -1, "rationale": "Objectif: am\u00e9liorer la qualit\u00e9 des donn\u00e9es et du RAG."}, {"id": "converted_build